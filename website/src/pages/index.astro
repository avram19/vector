---
import "../styles/landing.css";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import AgentStrip from "../components/AgentStrip.astro";
import DownloadCTA from "../components/DownloadCTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vector — an agent-first terminal</title>
    <meta name="description" content="A desktop terminal where every tab runs a coding agent (Claude Code, Codex, …) instead of a shell. macOS, Linux, and Windows." />
    <link rel="icon" href={`${base}/favicon.png`} />
  </head>
  <body class="landing">
    <SiteNav />
    <main>
      <Hero />
      <FeatureGrid />
      <AgentStrip />
      <section class="vibe">
        <h2>How it was built</h2>
        <p><strong>This is a vibe-coded app.</strong> A human supplied the requirements in plain English, and the implementation — Rust backend, React/TypeScript frontend, Tauri packaging, icon generation, all of it — was produced by an AI coding agent following those requirements. No line of code here was hand-written by the human who scoped the project.</p>
      </section>
      <DownloadCTA />
    </main>
    <SiteFooter />
  </body>
</html>
