---
import logo from "../assets/logo.png";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<header class="nav">
  <a class="brand" href={`${base}/`} style="display:inline-flex;align-items:center;gap:8px;"><img src={logo.src} width="26" height="26" alt="" /> Vector</a>
  <nav>
    <a href={`${base}/getting-started/install/`}>Docs</a>
    <a href="https://github.com/avram19/vector">GitHub</a>
    <a class="btn" href={`${base}/#download`}>Download</a>
  </nav>
</header>
