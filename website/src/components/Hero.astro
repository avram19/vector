---
import hero from "../assets/hero.png";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="hero">
  <img class="hero-bg" src={hero.src} width={hero.width} height={hero.height} alt="Vector running a coding agent" />
  <div class="hero-copy">
    <div class="hero-panel">
      <h1>An agent-first terminal</h1>
      <p>Every tab boots straight into a coding agent — Claude Code, Codex, Cursor, and more — instead of a shell prompt.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`${base}/#download`}>Download</a>
        <a class="btn" href={`${base}/getting-started/install/`}>Read the docs</a>
      </div>
      <p class="hero-sub">macOS, Linux &amp; Windows · free · <a href="https://github.com/avram19/vector">open source</a></p>
    </div>
  </div>
</section>
